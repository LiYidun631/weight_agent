# ==================== 服务基础配置 ====================
WEIGHT_AGENT_APP_NAME=Weight Agent API
WEIGHT_AGENT_ENVIRONMENT=development
WEIGHT_AGENT_DEBUG=false
WEIGHT_AGENT_HOST=127.0.0.1
WEIGHT_AGENT_PORT=8010
WEIGHT_AGENT_RELOAD=true
WEIGHT_AGENT_API_V1_PREFIX=/api/v1

# ==================== Chat 接口配置 ====================
WEIGHT_AGENT_CHAT_INTENT_MIN_CONFIDENCE=0.75
WEIGHT_AGENT_CHAT_INTENT_FALLBACK_CONFIDENCE=0.8
WEIGHT_AGENT_CHAT_INTENT_RULE_CONFIDENCE=0.84

# Chat 短期会话记忆；多实例生产环境后续替换为 Redis
WEIGHT_AGENT_CHAT_MEMORY_TTL_HOURS=24
WEIGHT_AGENT_CHAT_MEMORY_MAX_TURNS=10

# Chat 请求缺省上下文
WEIGHT_AGENT_CHAT_DEFAULT_TIMEZONE=Asia/Shanghai
WEIGHT_AGENT_CHAT_DEFAULT_LOCALE=zh-CN
# 是否向客户端暴露意图、路由和节点执行等内部调试事件；生产建议关闭
WEIGHT_AGENT_CHAT_EXPOSE_DEBUG_EVENTS=false
# 规则版 SSE 文本分片大小；真实流式模型接入后由模型 chunk 决定
WEIGHT_AGENT_CHAT_STREAM_CHUNK_SIZE=12
# 是否启用 Chat 真实模型；规则分类和规则建议始终作为兜底
WEIGHT_AGENT_CHAT_LLM_ENABLED=true

# Chat 意图识别模型（规则不确定时调用）
WEIGHT_AGENT_CHAT_INTENT_MODEL=qwen3.7-flash
WEIGHT_AGENT_CHAT_INTENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEIGHT_AGENT_CHAT_INTENT_MODEL_TIMEOUT_SECONDS=8
WEIGHT_AGENT_CHAT_INTENT_MODEL_TEMPERATURE=0
WEIGHT_AGENT_CHAT_INTENT_MODEL_MAX_COMPLETION_TOKENS=512
WEIGHT_AGENT_CHAT_INTENT_MODEL_ENABLE_THINKING=false

# Chat 健康建议模型（仅润色规则建议，不修改事实）
WEIGHT_AGENT_CHAT_ADVICE_MODEL=qwen3.7-flash
WEIGHT_AGENT_CHAT_ADVICE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEIGHT_AGENT_CHAT_ADVICE_MODEL_TIMEOUT_SECONDS=12
WEIGHT_AGENT_CHAT_ADVICE_MODEL_TEMPERATURE=0.2
WEIGHT_AGENT_CHAT_ADVICE_MODEL_MAX_COMPLETION_TOKENS=800
WEIGHT_AGENT_CHAT_ADVICE_MODEL_ENABLE_THINKING=false

# ==================== Report 接口配置 ====================
WEIGHT_AGENT_REPORT_MODEL_TIMEOUT_SECONDS=20
WEIGHT_AGENT_REPORT_MODEL=qwen3.8-flash

# ==================== 模型服务配置 ====================
DASHSCOPE_API_KEY=
WEIGHT_AGENT_REPORT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WEIGHT_AGENT_REPORT_MODEL_TEMPERATURE=0.2
WEIGHT_AGENT_REPORT_MODEL_MAX_COMPLETION_TOKENS=800
WEIGHT_AGENT_REPORT_MODEL_ENABLE_THINKING=false
WEIGHT_AGENT_REPORT_MODEL_STRICT_OUTPUT_VALIDATION=false
